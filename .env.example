# Copiar a .env y completar. .env está en .gitignore.
# Recomendado: usuarios de solo lectura por región.

MONGO_URI_CAS=mongodb+srv://readonly:<password>@cluster-cas.example.mongodb.net
MONGO_URI_CARIB=mongodb+srv://readonly:<password>@cluster-carib.example.mongodb.net
MONGO_URI_SA=mongodb+srv://readonly:<password>@cluster-sa.example.mongodb.net

COUCHBASE_CONNSTR_CAS=couchbases://cb-cas.example.cloud.couchbase.com
COUCHBASE_USER_CAS=readonly
COUCHBASE_PASSWORD_CAS=

COUCHBASE_CONNSTR_CARIB=couchbases://cb-carib.example.cloud.couchbase.com
COUCHBASE_USER_CARIB=readonly
COUCHBASE_PASSWORD_CARIB=

COUCHBASE_CONNSTR_SA=couchbases://cb-sa.example.cloud.couchbase.com
COUCHBASE_USER_SA=readonly
COUCHBASE_PASSWORD_SA=
